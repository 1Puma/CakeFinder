generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model CakeSpecRecord {
  id             String         @id
  bakeryId       String?
  specJson       String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  outreach       OutreachSend[]
}

model DecoratorRecord {
  id                        String   @id
  city                      String
  decoratorJson             String
  lastIndexedAt             DateTime
}

model CityIndex {
  city           String   @id
  lastCrawledAt  DateTime
  decoratorCount Int
}

model OutreachSend {
  id          String         @id
  specId      String
  spec        CakeSpecRecord @relation(fields: [specId], references: [id])
  decoratorId String
  toEmail     String
  status      String
  createdAt   DateTime       @default(now())
}

model Suppression {
  decoratorId String   @id
  createdAt   DateTime @default(now())
}

model MatchCache {
  specId     String   @id
  resultJson String
  updatedAt  DateTime @updatedAt
}
